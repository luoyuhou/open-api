# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

DATABASE_URL=mysql://root:123456@127.0.0.1:3306/database
PRISMA_LOG=error

# REDIS
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=password
REDIS_USE_TLS=

# APP
APP_SECRET=app_secret
SERVER_PORT=3001
WX_APP_ID=appId
WX_SECRET=wx_secret

# cashier
CASHIER_WX_APP_ID=xxx
CASHIER_WX_SECRET=yyy

# publisher
PUBLISHER_WX_APP_ID=xxx
PUBLISHER_WX_SECRET=yyy

# 环境：development 或 production
ENV=development
# 前端 URL（用于 CORS 配置）
FRONTEND_URL=http://localhost:3000

# qiniu
Q_ACCESS_KEY=ACCESS_KEY
Q_SECRET_KEY=SECRET_KEY
Q_BUCKET=BUCKET
Q_DOMAIN=DOMAIN

# SMS
SPUG_SMS_URL=SMS

# 一键发文：ALQQ 接口地址与执行端（API Key 按用户加密存库，不放 env）
ALQQ_API_BASE=https://www.alqq.cn
ALQQ_EXECUTOR=desktop